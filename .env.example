# ─────────────────────────────────────────────
# OpenCrab Environment Configuration
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────

# ── Storage Mode ──────────────────────────────
# "local"  → no Docker needed (SQLite + ChromaDB embedded + JSON files)
# "docker" → full services via docker-compose up -d
STORAGE_MODE=local

# Local data directory (used in local mode)
LOCAL_DATA_DIR=./opencrab_data

# ── Ingest chunking ───────────────────────────
# Split documents at headings (#–####) into chunks of at most
# OPENCRAB_CHUNK_MAX_CHARS characters before embedding. Read from the process
# environment (e.g. `docker exec -e OPENCRAB_CHUNKING=1 …`), not from this file.
# OPENCRAB_CHUNKING=1
# OPENCRAB_CHUNK_MAX_CHARS=1200
# OPENCRAB_CHUNK_BM25_LIMIT=10000

# ── Multilingual embeddings ───────────────────
# Local ONNX model for vector search (see docs/multilingual-embedding.md).
# Download first: python scripts/download_embedding_model.py <model>
# Read from the process environment (e.g. `docker exec -e …`), not from this file.
# OPENCRAB_EMBEDDING_MODEL=multilingual-e5-small
# OPENCRAB_EMBEDDING_MODEL_DIR=~/.cache/opencrab/models/multilingual-e5-small

# ── Docker Mode Only ──────────────────────────
# (ignored when STORAGE_MODE=local)

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=opencrab

# MongoDB
MONGODB_URI=mongodb://root:opencrab@localhost:27017
MONGODB_DB=opencrab

# PostgreSQL
POSTGRES_URL=postgresql://opencrab:opencrab@localhost:5432/opencrab

# ChromaDB (docker server)
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION=opencrab_vectors

# ── MCP ───────────────────────────────────────
MCP_SERVER_NAME=opencrab
MCP_SERVER_VERSION=0.1.0

# Logging
LOG_LEVEL=INFO
